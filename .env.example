# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Telegram (free). Create a bot with @BotFather, then message it once and
# read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional members channel. Set by `python -m scanner setup-channel`.
TELEGRAM_CHANNEL_ID=
CHANNEL_MIN_DEPTH=50         # members only get alerts with at least this many contracts at the price

# No Kalshi key needed: Kalshi market data is public. The scanner never sends auth
# headers and has no order code. Don't put a Kalshi key here.

# Where the SQLite file lives
DB_PATH=props.db

# Edge / alert tuning
MIN_NET_EDGE=0.03            # flag threshold, dollars per contract (3c)
ALERT_CONTRACTS=100          # size used for the per-order fee rounding and depth check
THIN_DEPTH_CONTRACTS=50      # depth at the ask below this -> THIN warning
MAX_REF_SPREAD=0.05          # reference venue spread wider than this -> not a usable fair price
WIDE_SPREAD_WARN=0.05        # buy venue spread wider than this -> spread warning
MIN_ALERT_CONFIDENCE=0.99    # only exact / alias / approved matches alert
ALERT_COOLDOWN_MIN=60        # re-alert same market+side only after this, or if edge grows
ALERT_EDGE_BUMP=0.02         # ...or if edge grew by at least this much
HOURS_AHEAD=36               # only scan games starting within this window
PAPER_STAKE_USD=100          # "would have bet $N" column
CLOSE_LEAD_MIN=2             # snapshot the close this many minutes before start
DNP_GAP=0.05                 # Kalshi-above-Poly median gap on >=2 lines (or 2x on one line) -> suppress (lineup news)
MAX_SANE_EDGE=0.15           # any single edge above this is suppressed as "check news first"

# UI (localhost only; the app refuses any other host)
UI_HOST=127.0.0.1
UI_PORT=8765
