# props-scanner (read-only). Times are US Eastern (this Mac's time zone).
# Install:  crontab cron/props.cron   (replaces your crontab; yours was empty on 2026-11-11)
# Remove:   crontab -r
# NBA nightly: scan every 3 min 4pm-11:59pm, closes every minute 6pm-11:59pm
*/3 16-23 * * *   cd /Users/abcd/props-scanner && mkdir -p logs && .venv/bin/python -m scanner scan --sports nba >> logs/scan.log 2>&1
* 18-23 * * *     cd /Users/abcd/props-scanner && mkdir -p logs && .venv/bin/python -m scanner closes >> logs/closes.log 2>&1
# NFL gamedays: Sunday 10am-8:59pm, Monday + Thursday 6pm-8:59pm
*/3 10-20 * * 0   cd /Users/abcd/props-scanner && mkdir -p logs && .venv/bin/python -m scanner scan --sports nfl >> logs/scan.log 2>&1
*/3 18-20 * * 1,4 cd /Users/abcd/props-scanner && mkdir -p logs && .venv/bin/python -m scanner scan --sports nfl >> logs/scan.log 2>&1
* 12-21 * * 0     cd /Users/abcd/props-scanner && mkdir -p logs && .venv/bin/python -m scanner closes >> logs/closes.log 2>&1
* 19-21 * * 1,4   cd /Users/abcd/props-scanner && mkdir -p logs && .venv/bin/python -m scanner closes >> logs/closes.log 2>&1
